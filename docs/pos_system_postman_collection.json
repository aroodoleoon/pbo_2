    {
      "name": "3. Pelanggan & Member",
      "item": [
        {
          "name": "Ambil Semua Pelanggan",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Data member terdeteksi\", function () {",
                  "    var json = pm.response.json();",
                  "    var member = json.find(p => p.isMember === true);",
                  "    pm.expect(member).to.not.be.undefined;",
                  "    pm.expect(member.points).to.be.at.least(100);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://127.0.0.1:8080/api/v1/customers"
          }
        },
        {
          "name": "Daftarkan Member Baru",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Member baru memiliki nomor member\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.isMember).to.be.true;",
                  "    pm.expect(json.memberNumber).to.be.a(\"string\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rina Marlina\",\n  \"contact\": \"081234455667\",\n  \"asMember\": true\n}"
            },
            "url": "http://127.0.0.1:8080/api/v1/customers"
          }
        }
      ]
    },
    {
      "name": "4. Transaksi & Pembayaran Atomik",
      "item": [
        {
          "name": "Hitung Keranjang Belanja Kasir (Draft)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Kalkulasi total dan diskon member valid\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.subtotal).to.be.above(0);",
                  "    pm.expect(json.total).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "22222222-2222-2222-2222-222222222222" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"plg-001\",\n  \"items\": [\n    {\n      \"productId\": \"brg-001\",\n      \"quantity\": 2\n    }\n  ],\n  \"discountAmount\": 0\n}"
            },
            "url": "http://127.0.0.1:8080/api/v1/sales"
          }
        },
        {
          "name": "Pembayaran Tunai Kasir (Sukses)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Status pembayaran SUCCESS dan kembalian tepat\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"SUCCESS\");",
                  "    pm.expect(json.changeAmount).to.eql(7000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sale\": {\n    \"transactionId\": \"TRX-PM-CLI-001\",\n    \"cashierId\": \"22222222-2222-2222-2222-222222222222\",\n    \"customerId\": \"plg-001\",\n    \"items\": [\n      {\n        \"itemId\": \"brg-001\",\n        \"quantity\": 2\n      }\n    ],\n    \"discountAmount\": 0\n  },\n  \"amountPaid\": 30000\n}"
            },
            "url": "http://127.0.0.1:8080/api/v1/payments/cash"
          }
        },
        {
          "name": "Pembayaran Tunai Kurang (Ditolak)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Error message pembayaran kurang\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.error.message).to.include(\"kurang\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sale\": {\n    \"transactionId\": \"TRX-PM-FAIL-001\",\n    \"cashierId\": \"22222222-2222-2222-2222-222222222222\",\n    \"items\": [\n      {\n        \"itemId\": \"brg-001\",\n        \"quantity\": 1\n      }\n    ]\n  },\n  \"amountPaid\": 5000\n}"
            },
            "url": "http://127.0.0.1:8080/api/v1/payments/cash"
          }
        }
      ]
