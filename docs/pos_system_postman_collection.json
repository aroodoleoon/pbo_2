{
  "info": {
    "name": "POS System OOP - Automated Test Suite",
    "description": "Koleksi pengujian otomatis Postman CLI untuk Sistem Kasir Point of Sale (POS) Tubes PBO.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Autentikasi",
      "item": [
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"User role is ADMIN\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.user.role).to.eql(\"ADMIN\");",
                  "    pm.expect(json.accessToken).to.be.a(\"string\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": "http://127.0.0.1:8080/api/v1/auth/login"
          }
        },
        {
          "name": "Login Kasir Pagi",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"User role is CASHIER\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.user.role).to.eql(\"CASHIER\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"kasir1\",\n  \"password\": \"kasir123\"\n}"
            },
            "url": "http://127.0.0.1:8080/api/v1/auth/login"
          }
        },
        {
          "name": "Logout Sesi",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "http://127.0.0.1:8080/api/v1/auth/logout"
          }
